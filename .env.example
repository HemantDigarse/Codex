# ──────────────────────────────────────────────────────────
# AI Code Explainer – Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Gemini API key.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# ── Google Gemini (FREE tier) ────────────────────────────
# Get your free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (default: gemini-2.0-flash)
# Free models available:
#   gemini-2.0-flash       – fast, great quality (recommended)
#   gemini-1.5-flash       – fast, good quality
#   gemini-1.5-pro         – highest quality, slower
GEMINI_MODEL=gemini-2.0-flash
